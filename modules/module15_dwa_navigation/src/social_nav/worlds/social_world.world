<?xml version="1.0"?>
<sdf version="1.6">
  <world name="social_nav_world">

    <!-- ═══════════════════════════════════════
         BASIC ENVIRONMENT — local URIs only
         (no internet / Fuel dependency)
    ═══════════════════════════════════════ -->

    <include>
      <uri>model://ground_plane</uri>
    </include>

    <include>
      <uri>model://sun</uri>
    </include>

    <!-- Physics tuned for TurtleBot3 + human actors -->
    <physics type="ode">
      <real_time_update_rate>1000.0</real_time_update_rate>
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <ode>
        <solver>
          <type>quick</type>
          <iters>150</iters>
          <sor>1.4</sor>
        </solver>
      </ode>
    </physics>

    <!-- ═══════════════════════════════════════
         ROOM WALLS (10m x 10m indoor space)
    ═══════════════════════════════════════ -->

    <model name="wall_north">
      <static>true</static>
      <pose>0 5 1 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>10 0.2 2</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>10 0.2 2</size></box></geometry>
          <material><script>
            <uri>file://media/materials/scripts/gazebo.material</uri>
            <name>Gazebo/Grey</name>
          </script></material>
        </visual>
      </link>
    </model>

    <model name="wall_south">
      <static>true</static>
      <pose>0 -5 1 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>10 0.2 2</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>10 0.2 2</size></box></geometry>
          <material><script>
            <uri>file://media/materials/scripts/gazebo.material</uri>
            <name>Gazebo/Grey</name>
          </script></material>
        </visual>
      </link>
    </model>

    <model name="wall_east">
      <static>true</static>
      <pose>5 0 1 0 0 1.5708</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>10 0.2 2</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>10 0.2 2</size></box></geometry>
          <material><script>
            <uri>file://media/materials/scripts/gazebo.material</uri>
            <name>Gazebo/Grey</name>
          </script></material>
        </visual>
      </link>
    </model>

    <model name="wall_west">
      <static>true</static>
      <pose>-5 0 1 0 0 1.5708</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>10 0.2 2</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>10 0.2 2</size></box></geometry>
          <material><script>
            <uri>file://media/materials/scripts/gazebo.material</uri>
            <name>Gazebo/Grey</name>
          </script></material>
        </visual>
      </link>
    </model>

    <!-- ═══════════════════════════════════════
         STATIC OBSTACLES
    ═══════════════════════════════════════ -->

    <model name="sofa">
      <static>true</static>
      <pose>-3.0 -3.0 0.4 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>1.8 0.8 0.8</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1.8 0.8 0.8</size></box></geometry>
          <material><script>
            <uri>file://media/materials/scripts/gazebo.material</uri>
            <name>Gazebo/Blue</name>
          </script></material>
        </visual>
      </link>
    </model>

    <model name="table">
      <static>true</static>
      <pose>3.0 3.0 0.4 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>1.2 0.8 0.8</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1.2 0.8 0.8</size></box></geometry>
          <material><script>
            <uri>file://media/materials/scripts/gazebo.material</uri>
            <name>Gazebo/Wood</name>
          </script></material>
        </visual>
      </link>
    </model>

    <model name="pillar">
      <static>true</static>
      <pose>0.5 0.5 1.0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><cylinder><radius>0.2</radius><length>2.0</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.2</radius><length>2.0</length></cylinder></geometry>
          <material><script>
            <uri>file://media/materials/scripts/gazebo.material</uri>
            <name>Gazebo/DarkGrey</name>
          </script></material>
        </visual>
      </link>
    </model>

    <!-- ═══════════════════════════════════════
         HUMAN ACTOR 1 — walks horizontally
    ═══════════════════════════════════════ -->
    <actor name="human_1">
      <skin>
        <filename>walk.dae</filename>
        <scale>1.0</scale>
      </skin>
      <animation name="walking">
        <filename>walk.dae</filename>
        <scale>1.0</scale>
        <interpolate_x>true</interpolate_x>
      </animation>
      <script>
        <loop>true</loop>
        <delay_start>0.0</delay_start>
        <auto_start>true</auto_start>
        <trajectory id="0" type="walking">
          <waypoint><time>0.0</time><pose>-4.0 -1.0 0 0 0 0</pose></waypoint>
          <waypoint><time>4.0</time><pose>0.0 -1.0 0 0 0 0</pose></waypoint>
          <waypoint><time>8.0</time><pose>4.0 -1.0 0 0 0 3.1416</pose></waypoint>
          <waypoint><time>12.0</time><pose>0.0 -1.0 0 0 0 3.1416</pose></waypoint>
          <waypoint><time>16.0</time><pose>-4.0 -1.0 0 0 0 0</pose></waypoint>
        </trajectory>
      </script>
    </actor>

    <!-- ═══════════════════════════════════════
         HUMAN ACTOR 2 — walks vertically
    ═══════════════════════════════════════ -->
    <actor name="human_2">
      <skin>
        <filename>walk.dae</filename>
        <scale>1.0</scale>
      </skin>
      <animation name="walking">
        <filename>walk.dae</filename>
        <scale>1.0</scale>
        <interpolate_x>true</interpolate_x>
      </animation>
      <script>
        <loop>true</loop>
        <delay_start>3.0</delay_start>
        <auto_start>true</auto_start>
        <trajectory id="0" type="walking">
          <waypoint><time>0.0</time><pose>2.0 -4.0 0 0 0 1.5708</pose></waypoint>
          <waypoint><time>4.0</time><pose>2.0  0.0 0 0 0 1.5708</pose></waypoint>
          <waypoint><time>8.0</time><pose>2.0  4.0 0 0 0 -1.5708</pose></waypoint>
          <waypoint><time>12.0</time><pose>2.0 0.0 0 0 0 -1.5708</pose></waypoint>
          <waypoint><time>16.0</time><pose>2.0 -4.0 0 0 0 1.5708</pose></waypoint>
        </trajectory>
      </script>
    </actor>

    <!-- ═══════════════════════════════════════
         HUMAN ACTOR 3 — L-shaped path
    ═══════════════════════════════════════ -->
    <actor name="human_3">
      <skin>
        <filename>walk.dae</filename>
        <scale>1.0</scale>
      </skin>
      <animation name="walking">
        <filename>walk.dae</filename>
        <scale>1.0</scale>
        <interpolate_x>true</interpolate_x>
      </animation>
      <script>
        <loop>true</loop>
        <delay_start>6.0</delay_start>
        <auto_start>true</auto_start>
        <trajectory id="0" type="walking">
          <waypoint><time>0.0</time><pose>-3.0  3.0 0 0 0 0</pose></waypoint>
          <waypoint><time>6.0</time><pose> 3.0  3.0 0 0 0 -1.5708</pose></waypoint>
          <waypoint><time>12.0</time><pose>3.0 -3.0 0 0 0  2.356</pose></waypoint>
          <waypoint><time>20.0</time><pose>-3.0  3.0 0 0 0 0</pose></waypoint>
        </trajectory>
      </script>
    </actor>

    <!-- Goal marker — green disc at (3.5, 2.0) -->
    <model name="goal_marker">
      <static>true</static>
      <pose>3.5 2.0 0.05 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><cylinder><radius>0.15</radius><length>0.1</length></cylinder></geometry>
          <material><script>
            <uri>file://media/materials/scripts/gazebo.material</uri>
            <name>Gazebo/Green</name>
          </script></material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
